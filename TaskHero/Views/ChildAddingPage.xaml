<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaskHero.Views.ChildAddingPage"
             BackgroundImageSource="background.png">
    <VerticalStackLayout Margin="20" VerticalOptions="Center">
        <Label 
            Text="What is your child" 
            VerticalOptions="Center" 
            HorizontalOptions="Center" FontSize="30" />
        <Border StrokeShape =" RoundRectangle 10 " BackgroundColor ="WhiteSmoke" Margin="20">
            <Entry Placeholder="Enter child name" PlaceholderColor="Black" x:Name="_childName" ></Entry>
        </Border>
        <Label 
        Text="Child NickName" 
        VerticalOptions="Center" 
        HorizontalOptions="Center" FontSize="30" />
        <Border StrokeShape =" RoundRectangle 10 " BackgroundColor ="WhiteSmoke" Margin="20">
            <Entry Placeholder="Enter child nickname" PlaceholderColor="Black" x:Name="_childNick"></Entry>
        </Border>
        
        
        <Button Text="Save" Clicked="OnSaveClicked"></Button>
    </VerticalStackLayout>
</ContentPage>