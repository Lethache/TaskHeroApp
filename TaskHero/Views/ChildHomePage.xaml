<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaskHero.Views.ChildHomePage" BackgroundImageSource="background.png">
    <ContentPage.Content>
        <CollectionView ItemsSource="{Binding CrtTask}" >
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                   ItemSpacing="15"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>

                <DataTemplate >
                    <Border  Padding="10" Margin="5" BackgroundColor="AliceBlue"  >

                        <Grid RowDefinitions="*,*" ColumnDefinitions="*">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToggleExpand" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout  >
                                <Label  Text="{Binding TaskName}"  Grid.Column="0" Grid.Row="0"></Label>
                                <VerticalStackLayout Grid.Column="0" Grid.Row="1"  IsVisible="{Binding IsExpanded}">
                                    <Label Text="{Binding Description}"></Label>
                                    <Label Text="{Binding Reward}"></Label>
                                    
                                    <Label Text="{Binding TaskStatusText}" ></Label>
                                    <Button Text="Mark as Complete"></Button>
                                </VerticalStackLayout>
                            </VerticalStackLayout>



                        </Grid>

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </ContentPage.Content>
</ContentPage>