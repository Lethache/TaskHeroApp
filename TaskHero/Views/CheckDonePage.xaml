<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaskHero.Views.CheckDonePage"
             BackgroundImageSource="background.png">
    <VerticalStackLayout Margin="15">
        <Label Text="Available Tasks" 
               HorizontalOptions="Center"
               TextColor="AliceBlue"
               FontSize="30"
               FontAttributes="Bold"></Label>
        <CollectionView ItemsSource="{Binding CrtTask}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                           ItemSpacing="15"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border  Padding="10"  BackgroundColor="AliceBlue"
                         Stroke="{Binding TaskColor}"
                         StrokeThickness="4" >
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15"/>
                        </Border.StrokeShape>
                        <Grid RowDefinitions="*,*" ColumnDefinitions="*,*,*" >
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToggleExpand" />
                            </Grid.GestureRecognizers>

                            <Label Text="{Binding TaskName}"  
                                           HorizontalOptions="Start"
                                           VerticalOptions="Center"
                                           TextColor="DarkSlateGray"
                                           Grid.Column="0" Grid.Row="0"
                                           FontSize="20" FontAttributes="Bold"/>
                            <Button Text="Del" 
                                            Clicked="OnDeleteTaskClicked" 
                                            HorizontalOptions="End"
                                            Grid.Column="2" Grid.Row="0"/>

                            <VerticalStackLayout Grid.ColumnSpan="3" Grid.Row="1"  IsVisible="{Binding IsExpanded}">
                                <Label Text="{Binding Description, StringFormat='Description: {0}'}" 
                                       TextColor="DarkSlateGray"
                                       FontSize="16"></Label>
                                <Label Text="{Binding Reward, StringFormat='Reward: {0}'}" 
                                       TextColor="DarkSlateGray"
                                       FontSize="16"></Label>
                                <Label Text="{Binding TaskStatusText, StringFormat='Status: {0}'}" 
                                       TextColor="DarkSlateGray" 
                                       FontSize="16"></Label>
                                <HorizontalStackLayout Spacing="10" Margin="0,10,0,10">
                                    <Button Text=" Accept " IsVisible="{Binding IsComplete}" 
                                            WidthRequest="100"
                                            BackgroundColor="GreenYellow"
                                            Clicked="OnAcceptTaskClicked"/>
                                    <Button Text="Reject " IsVisible= "{Binding IsComplete}" 
                                            WidthRequest="100"
                                            BackgroundColor="Red"
                                            Clicked="OnRejectTaskClicked"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>