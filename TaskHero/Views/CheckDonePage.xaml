<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaskHero.Views.CheckDonePage"
             BackgroundImageSource="background.png">
    <VerticalStackLayout>
        <CollectionView ItemsSource="{Binding CrtTask}">
            <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border  Padding="10" Margin="5" BackgroundColor="AliceBlue">
                    <HorizontalStackLayout Spacing="10">
                        <Grid RowDefinitions="*,*" ColumnDefinitions="*,*,*">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnToggleExpand" />
                                </Grid.GestureRecognizers>
                                <Label Text="{Binding TaskName}"  Grid.Column="1" Grid.Row="0"></Label>
                                <VerticalStackLayout  IsVisible="{Binding IsExpanded}">
                                    <Label Text="{Binding Description}"></Label>
                                    <Label Text="{Binding Reward}"></Label>
                                    <Button Text=" Accept " IsVisible="{Binding IsComplete}"></Button>
                                    <Button Text="Reject " IsVisible= "{Binding IsComplete}"></Button>
                                    <Label Text="{Binding TaskStatusText}" ></Label>
                                </VerticalStackLayout>
                                

                        </Grid>
                    </HorizontalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>