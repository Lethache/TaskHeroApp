<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaskHero.Views.CheckDonePage"
             BackgroundImageSource="background.png">
    <VerticalStackLayout Spacing="20">
        <Label Text="Task Page " VerticalOptions="Center" HorizontalOptions="Center" FontSize="Header" FontAttributes="Bold"></Label>
        <CollectionView ItemsSource="{Binding CrtTask}" >
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                           ItemSpacing="15"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                
            <DataTemplate >
                <Border  Padding="10" Margin="5" BackgroundColor="AliceBlue"  >
                    
                        <Grid RowDefinitions="*,*" ColumnDefinitions="*">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnToggleExpand" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout  >
                                    <Label  Text="{Binding TaskName}"  Grid.Column="0" Grid.Row="0"></Label>
                                    <VerticalStackLayout Grid.Column="0" Grid.Row="1"  IsVisible="{Binding IsExpanded}">
                                    <Label Text="{Binding Description}"></Label>
                                    <Label Text="{Binding Reward}"></Label>
                                    <Button Text=" Accept " IsVisible="{Binding IsComplete}"></Button>
                                    <Button Text="Reject " IsVisible= "{Binding IsComplete}"></Button>
                                    <Label Text="{Binding TaskStatusText}" ></Label>
                                </VerticalStackLayout>
                                </VerticalStackLayout>
                                
                                

                        </Grid>
                    
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>