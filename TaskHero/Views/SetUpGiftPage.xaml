<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 x:Class="TaskHero.Views.SetUpGiftPage"
			  BackgroundImageSource="background.png">

    <VerticalStackLayout Margin="20" VerticalOptions="Center">
        <Label 
				Text="Gift Name"
				VerticalOptions="Center" 
				HorizontalOptions="Center" FontSize="30" />
        <Border StrokeShape =" RoundRectangle 10 " BackgroundColor ="WhiteSmoke" Margin="20">
            <Entry Placeholder="Enter gift Name" Text="{Binding GiftName}" PlaceholderColor="Black" ></Entry>
        </Border>
        <Label 
			Text="Gift Description "
			VerticalOptions="Center" 
			HorizontalOptions="Center" FontSize="30" />
        <Border StrokeShape =" RoundRectangle 10 " BackgroundColor ="WhiteSmoke" Margin="20">
            <Entry Placeholder="Enter gift Description" Text="{Binding GiftDescription}" PlaceholderColor="Black" ></Entry>
        </Border>

        <Label Text="Gift Cost"
		       VerticalOptions="Center" 
		       HorizontalOptions="Center" FontSize="30" />

        <Border StrokeShape =" RoundRectangle 10 " BackgroundColor ="WhiteSmoke" Margin="20">
            <Entry Placeholder="Enter gift reward" Text="{Binding GiftCost}" PlaceholderColor="Black" ></Entry>
        </Border>

        <Label Text="Add Photo"
		       VerticalOptions="Center" 
		       HorizontalOptions="Center" FontSize="30" />
        <Border StrokeShape =" RoundRectangle 10 " BackgroundColor ="WhiteSmoke" Margin="20">
            <VerticalStackLayout>
                <Button Text="Choose Image" Clicked="OnChooseImage" />

                <Image Source="{Binding SelectedImagePath}"
                       HeightRequest="200"
                       WidthRequest="200"
                       Aspect="AspectFit"
                       IsVisible="{Binding HasImage}"/>
            </VerticalStackLayout>

        </Border>
        <Button Text="Save" Clicked="OnSaveClicked"></Button>
    </VerticalStackLayout>

</ContentPage>