<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaskHero.Views.ChildRegisterPage"
             BackgroundImageSource="background.png">
    <VerticalStackLayout VerticalOptions="Center" Margin="20" Spacing="40">
        <Label 
            Text="Enter Code"
            VerticalOptions="Center" 
            HorizontalOptions="Center" FontSize="Header" />

        <Border Margin="10"  BackgroundColor="BlanchedAlmond" StrokeShape="RoundRectangle 20" VerticalOptions="Center"
        HorizontalOptions="Fill">
            <Entry Placeholder="ABC123" TextColor="Black" PlaceholderColor="Black"></Entry>
        </Border>
        <Button Text="Add new child" Clicked="OnSaveButtonClicked"></Button>
    </VerticalStackLayout>
</ContentPage>