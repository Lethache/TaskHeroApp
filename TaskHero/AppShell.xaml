<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TaskHero.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TaskHero.Views"
    Title="TaskHero">

    <ShellContent
        
        ContentTemplate="{DataTemplate local:EntranceScreen}"
        Route="EntranceScreen" />
    <ShellContent
    
    ContentTemplate="{DataTemplate local:ParentChildPage}"
    Route="ParentChildPage" />

    <ShellContent

    ContentTemplate="{DataTemplate local:ChildAddingPage}"
    Route="ChildAddingPage"/>

<ShellContent

    ContentTemplate="{DataTemplate local:ChildRegisterPage}"
    Route="ChildRegisterPage"/>
    <ShellContent

    ContentTemplate="{DataTemplate local:HomeScreen}"
    Route="HomeScreen"/>

    
</Shell>
